BOT_TOKEN=your_bot_token_here

# Публичный адрес приложения (только для webhook-режима на Render).
WEBHOOK_URL=

# Секрет проверки заголовка X-Telegram-Bot-Api-Secret-Token.
# Пусто = проверка выключена. Для публичного деплоя обязательно задайте.
WEBHOOK_SECRET=

# Токен для ручного вызова POST /set-webhook и /delete-webhook.
# Пусто = админ-маршруты отключены.
ADMIN_TOKEN=

# Строка подключения MongoDB. Обязательна: ник, username, число верных
# ответов и лучшая серия хранятся только там (локального фолбэка нет).
# Пример: mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=

# Имя базы внутри кластера MongoDB.
MONGODB_DB=ege_paronym_bot
